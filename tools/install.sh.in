#!/usr/bin/env bash
# Generated by CMake into build/install.sh — copies the built plug-ins to the user plug-in folders.
set -euo pipefail
ART="@CMAKE_BINARY_DIR@/TheQueen_artefacts/${1:-Release}"
copy() { # src dest-dir
    [ -e "$1" ] || { echo "skip (not built): $1"; return; }
    mkdir -p "$2"
    rm -rf "$2/$(basename "$1")"
    cp -R "$1" "$2/"
    echo "installed $(basename "$1") -> $2"
}
# non-embedded builds (-DQUEEN_EMBED_ASSETS=OFF) read the GUI art from the per-user data folder
if [ "@QUEEN_EMBED_ASSETS@" != "ON" ]; then
    if [ "$(uname)" = "Darwin" ]; then A="$HOME/Library/Application Support/The Queen/Assets"; else A="$HOME/.config/The Queen/Assets"; fi
    mkdir -p "$A" && cp "@CMAKE_SOURCE_DIR@"/assets/*.png "$A/" && echo "installed GUI art -> $A"
fi
if [ "$(uname)" = "Darwin" ]; then
    P="$HOME/Library/Audio/Plug-Ins"
    copy "$ART/AU/The Queen.component" "$P/Components"
    copy "$ART/VST3/The Queen.vst3" "$P/VST3"
    copy "$ART/CLAP/The Queen.clap" "$P/CLAP"
    codesign --force --deep -s - "$P/Components/The Queen.component" 2>/dev/null || true
    killall -9 AudioComponentRegistrar 2>/dev/null || true
else
    copy "$ART/VST3/The Queen.vst3" "$HOME/.vst3"
    copy "$ART/CLAP/The Queen.clap" "$HOME/.clap"
fi
